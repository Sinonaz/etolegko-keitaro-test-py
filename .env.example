# Copied to .env for docker compose / local backend
APP_NAME=keitaro-wrapper
DEBUG=true

# Overridden by docker-compose for the backend service
DATABASE_URL=sqlite:///./app.db

# Keitaro Admin API (required for real tests)
KEITARO_URL=https://your-tracker.example
KEITARO_API_KEY=

KEITARO_DOMAIN_ID=
KEITARO_GROUP_ID=
KEITARO_SOURCE_ID=

KEITARO_DOMAIN_NAME=
KEITARO_GROUP_NAME=FORTESTS
KEITARO_SOURCE_NAME=FORTESTS
KEITARO_WHITE_PAGE_URL=https://google.com
