# App
APP_NAME=keitaro-wrapper
DEBUG=true

# Database (SQLite for local; switch to Postgres in Docker later)
DATABASE_URL=sqlite:///./app.db

# Keitaro Admin API
KEITARO_URL=https://your-tracker.example
KEITARO_API_KEY=

# Optional defaults for campaign creator (resolve via API if empty)
KEITARO_DOMAIN_ID=
KEITARO_GROUP_ID=
KEITARO_SOURCE_ID=
