# App
APP_NAME=keitaro-wrapper
DEBUG=true

# Database (SQLite for local; switch to Postgres in Docker later)
DATABASE_URL=sqlite:///./app.db

# Keitaro Admin API
KEITARO_URL=https://your-tracker.example
KEITARO_API_KEY=

# Optional IDs for campaign creator (if empty — resolve by name below)
KEITARO_DOMAIN_ID=
KEITARO_GROUP_ID=
KEITARO_SOURCE_ID=

KEITARO_DOMAIN_NAME=
KEITARO_GROUP_NAME=FORTESTS
KEITARO_SOURCE_NAME=FORTESTS
KEITARO_WHITE_PAGE_URL=https://google.com
